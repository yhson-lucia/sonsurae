# 손수레 환경 변수 템플릿
#
# 실제 값은 .env.local 에 채운다. 그 파일은 git 에 올라가지 않는다.
# Supabase 프로젝트가 만들어지기 전이라면 이 파일은 비어 있어도 무방하다.
# (Phase 7 데이터 마이그레이션 직전에 채우면 됨)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 (어드민/마이그레이션용 — 절대 클라이언트 번들에 노출 X)
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 URL (sitemap / OG / canonical 용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 마이그레이션 스크립트 — 글의 작성자가 될 auth.users 의 id (UUID)
#   1) Supabase 대시보드 또는 앱에서 회원가입한 뒤
#   2) Authentication → Users 에서 본인 user id 복사해서 채움
AUTHOR_USER_ID=

# (선택) 마이그레이션 스크립트가 읽는 원본 경로
MIGRATION_TEMP_DIR=./migration-temp
